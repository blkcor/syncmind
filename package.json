{
  "name": "syncmind",
  "private": true,
  "version": "0.0.0",
  "description": "Privacy-first, fully offline proactive local context engine",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:desktop": "pnpm --filter @syncmind/desktop tauri build",
    "dev": "pnpm -r dev",
    "dev:desktop": "pnpm --filter @syncmind/desktop tauri dev",
    "lint": "pnpm -r lint",
    "lint:mobile": "pnpm --filter mobile lint",
    "start:mobile": "pnpm --filter mobile start",
    "start:mobile:android": "pnpm --filter mobile android",
    "start:mobile:ios": "pnpm --filter mobile ios",
    "start:mobile:web": "pnpm --filter mobile web",
    "test": "pnpm -r test",
    "test:mobile": "pnpm --filter mobile test",
    "typecheck": "pnpm -r typecheck",
    "typecheck:mobile": "pnpm --filter mobile typecheck"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
